# ==============================================================================
# KnowGuard 智能知识库管理平台环境变量配置示例 (.env.example)
# ==============================================================================

# [系统基础配置]
ENVIRONMENT=development
DEBUG=True
APP_NAME=KnowGuard
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# [服务网络与跨域配置]
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# [关系型数据库 - MySQL 8.0+]
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=knowguard
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/knowguard?charset=utf8mb4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# [向量数据库 - Milvus 2.4+ (Linux VM Docker: 192.168.6.134)]
MILVUS_HOST=192.168.6.134
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=knowguard_chunks
MILVUS_DIMENSION=1024
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW

# [文档型数据库 - MongoDB 7.0+ (Linux VM Docker: 192.168.6.134)]
MONGODB_URL=mongodb://192.168.6.134:27017
MONGODB_DATABASE=knowguard

# [缓存与限流配置 - Redis 7.0]
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# [分布式异步任务 - Celery]
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# [安全与认证配置 - JWT & Bcrypt]
SECRET_KEY=knowguard-super-secret-key-change-me-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# [对象存储配置 - MinIO / 本地存储 (Linux VM Docker: 192.168.6.134)]
MINIO_ENDPOINT=192.168.6.134:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowguard-documents
MINIO_SECURE=False

# [大语言模型适配层 - 通义千问 Qwen / DashScope]
# [用户必填项 - 请在此填写真实阿里云 DashScope API Key]
DASHSCOPE_API_KEY=
# [可选模型: qwen-max, qwen-plus, qwen-turbo]
QWEN_MODEL_NAME=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_PROVIDER=qwen

# [本地向量与排序模型 - BGE 系列]
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_PROVIDER=local_bge_reranker
RERANKER_MODEL_PATH=BAAI/bge-reranker-large

# [可选辅助模型 - Gemini]
GEMINI_API_KEY=

# [可观测性与追踪 - OpenTelemetry]
OTEL_ENABLED=False
OTEL_SERVICE_NAME=knowguard-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
